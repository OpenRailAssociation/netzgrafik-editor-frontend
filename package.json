{
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:local": "ng serve --configuration=local",
    "start:standalone": "ng serve --configuration=standalone",
    "start:standalonedemo": "ng serve --configuration=standalonedemo",
    "build": "ng run netzgrafik-frontend:ngsscbuild",
    "build:standalone": "ng build --configuration=standalone && tsc --project tsconfig.defs.json",
    "build:standalonedemo": "ng build --configuration=standalonedemo",
    "test": "ng test -c ci",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "generate:api": "openapi-generator-cli generate",
    "local-test": "ng test --watch --code-coverage",
    "extract-i18n": "ng extract-i18n",
    "benchmark": "ng test -c benchmark"
  },
  "name": "@openrail/netzgrafik-editor-frontend",
  "version": "2.11.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenRailAssociation/netzgrafik-editor-frontend.git"
  },
  "files": [
    "dist/*"
  ],
  "types": "dist/types/types.d.ts",
  "exports": {
    "./index.html": {
      "default": "./dist/index.html"
    },
    ".": {
      "types": "./dist/types/types.d.ts",
      "default": "./dist/out-tsc/types.js"
    }
  },
  "dependencies": {
    "@angular/animations": "^21.2.20",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.20",
    "@angular/compiler": "^21.2.20",
    "@angular/core": "^21.2.20",
    "@angular/elements": "^21.2.20",
    "@angular/forms": "^21.2.20",
    "@angular/localize": "^21.2.20",
    "@angular/platform-browser": "^21.2.20",
    "@angular/router": "^21.2.20",
    "@sbb-esta/angular": "^21.0.3",
    "angular-oauth2-oidc": "^21.0.3",
    "angular-server-side-configuration": "^21.0.4",
    "d3": "^7.9.0",
    "dompurify": "^3.4.13",
    "extract-i18n": "^1.0.0",
    "ngx-editor": "^18.0.0",
    "papaparse": "^5.5.4",
    "rxjs": "^7.8.2",
    "save-svg-as-png": "^1.4.17",
    "tslib": "^2.5.3",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.21",
    "@angular/cli": "^21.2.21",
    "@angular/compiler-cli": "^21.2.20",
    "@angular/language-service": "^21.2.20",
    "@commitlint/types": "^21.2.0",
    "@eslint/js": "^9.39.4",
    "@openapitools/openapi-generator-cli": "^2.40.1",
    "@types/d3": "^7.4.3",
    "@types/jasmine": "~6.0.0",
    "@types/jasminewd2": "~2.0.13",
    "@types/node": "^26.2.0",
    "@types/papaparse": "^5.3.2",
    "angular-eslint": "^21.4.0",
    "browserstack-local": "^1.5.12",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jasmine-core": "^6.3.0",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "^6.4.4",
    "karma-browserstack-launcher": "^1.6.0",
    "karma-chrome-launcher": "^3.1.1",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "karma-sonarqube-reporter": "^1.4.0",
    "prettier": "^3.9.6",
    "ts-node": "~10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
